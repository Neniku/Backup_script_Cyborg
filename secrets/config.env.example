# Cyborg backup — local configuration
# Copy this file to secrets/config.env, fill in the values, and never commit it.
# The script sources this file automatically if it exists.

# Source directory to back up
SOURCE_DIR=""

# Remote server (IP or hostname)
DEST_SERVER=""

# Remote username
REMOTE_USER=""

# Remote password — alternatively, set SSH_KEY_PATH below and leave this empty
CYBORG_PASS=""

# Path to SSH private key for SFTP (recommended over password auth)
# Example: SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
SSH_KEY_PATH=""

# SMB share path on the server (e.g. /Samba or /backup)
SMB_PATH="/backup"

# Email address for the backup report
SYSADMIN_EMAIL=""

# Password to protect local logs and HTML report in ~/.backup_logs/ (.zip)
# Double-click the .zip in your file manager and enter this password to view
LOG_PASSWORD=""

# Optional: direct SMTP email delivery via curl (no local MTA/mailutils required)
SMTP_SERVER=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
