# Cyborg backup — local configuration
# Copy this file to secrets/config.env, fill in the values, and never commit it.
# The script sources this file automatically if it exists.

# Source directory to back up (param1)
SOURCE_DIR=""

# Remote server IP or hostname (param2)
DEST_SERVER=""

# Remote username (param3)
REMOTE_USER=""

# Remote password (param4 — used for SMB and SFTP password fallback via sshpass)
CYBORG_PASS=""

# Upload protocol (param5): "both" (default Cyborg: SFTP + SMB), "sftp", "ftp", or "smb"
PROTOCOL_MODE="both"

# Path to ECC SSH private key for SFTP (Ed25519 or ECDSA recommended)
# Auto-detected from ~/.ssh/id_ed25519 or ~/.ssh/id_ecdsa if left empty
SSH_KEY_PATH=""

# SMB share path on the server (e.g. /Samba or /backup) and SMB digital signing policy
SMB_PATH="/backup"
SMB_SIGNING="required"

# Email address for the HTML report and diario-backup.log attachment
SYSADMIN_EMAIL=""

# Password to protect local logs (diario-backup.log) and HTML report in ~/.backup_logs/ (.zip)
LOG_PASSWORD=""

# Optional: direct SMTP email delivery via curl (no local MTA/mailutils required)
SMTP_SERVER=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
